{
  "ouaf": "1",
  "id": "glasses",
  "name": { "en": "Disguise glasses", "fr": "Lunettes de déguisement" },
  "version": "1.0.0",
  "description": {
    "en": "Demo of the model and sticker layers: glTF glasses on the eyes, whose temples are hidden by the head (occlusion), a moustache that follows the upper lip and glints on the lenses.",
    "fr": "Calques modèle et sticker : des lunettes glTF dont les branches sont cachées par la tête (occultation), une moustache qui suit la lèvre et des reflets sur les verres."
  },
  "author": "Ouaf contributors",
  "license": "CC0-1.0",
  "tags": ["demo", "model", "sticker", "gltf"],
  "requires": { "face": true },
  "params": {
    "size": { "type": "number", "default": 1, "min": 0.8, "max": 1.3, "step": 0.05, "transition": 200, "label": { "en": "Glasses size", "fr": "Taille des lunettes" } },
    "mustache": { "type": "boolean", "default": true, "label": { "en": "Moustache", "fr": "Moustache" } },
    "shine": { "type": "boolean", "default": true, "label": { "en": "Glints", "fr": "Reflets" } }
  },
  "assets": {
    "glasses": "assets/glasses.glb",
    "mustache": "assets/mustache.svg",
    "shine": "assets/shine.svg"
  },
  "layers": [
    { "id": "glasses", "type": "model", "src": "glasses", "anchor": "eyes", "offset": [0, -0.04, 0.12], "scale": { "param": "size" }, "occlusion": "head" },
    { "id": "mustache", "type": "sticker", "src": "mustache", "anchor": "upperLip", "offset": [0, 0.1, 0.05], "size": 0.45, "visible": { "param": "mustache" } },
    { "id": "glint-big", "type": "sticker", "src": "shine", "anchor": "eyes", "offset": [-0.66, 0.1, 0.14], "size": 0.2, "blend": "screen", "visible": { "param": "shine" } },
    { "id": "glint-small", "type": "sticker", "src": "shine", "anchor": "eyes", "offset": [0.38, 0.1, 0.14], "size": 0.14, "blend": "screen", "visible": { "param": "shine" } }
  ]
}
