{
  "name": "ouaf-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ouaf/playground",
    "build": "npm run build -w @ouaf/playground",
    "build:schema": "npm run build:schema -w @ouaf/spec",
    "fetch-models": "npm run fetch-models -w @ouaf/playground",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-ar-filter/ouaf.git"
  }
}
