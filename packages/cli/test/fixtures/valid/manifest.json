{
  "ouaf": "1",
  "id": "fixture-valid",
  "name": { "en": "Valid fixture", "fr": "Exemple valide" },
  "version": "1.0.0",
  "license": "CC0-1.0",
  "thumbnail": "assets/thumb.png",
  "requires": { "face": true },
  "params": {
    "amount": { "type": "number", "default": 0.5, "min": 0, "max": 1 }
  },
  "assets": {
    "star": "assets/star.png",
    "grade": "assets/grade.cube",
    "glitch": "assets/glitch.frag"
  },
  "layers": [
    { "type": "sticker", "src": "star", "anchor": "forehead", "size": 0.5 },
    { "type": "text", "text": "Hi", "anchor": "chin", "font": "builtin:font/rounded-bold" },
    { "type": "color", "lut": "grade", "intensity": 0.8 },
    { "type": "shader", "src": "glitch", "uniforms": { "amount": { "param": "amount" } } }
  ]
}
