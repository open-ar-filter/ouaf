{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ouaf", "id", "name", "version", "license", "requires", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "ouaf": { "type": "string", "const": "1", "description": "Major version of the Ouaf format." },
    "engine": {
      "type": "string",
      "pattern": "^[\\^~]?\\d+(\\.\\d+){0,2}(-[0-9A-Za-z.-]+)?$",
      "description": "Compatible engine versions.",
      "default": "^1"
    },
    "id": { "$ref": "#/$defs/Id" },
    "name": { "$ref": "#/$defs/LocalizedText" },
    "version": { "$ref": "#/$defs/SemVer" },
    "description": { "$ref": "#/$defs/LocalizedText" },
    "author": { "type": "string", "maxLength": 200 },
    "license": { "$ref": "#/$defs/Spdx" },
    "credits": { "type": "array", "items": { "$ref": "#/$defs/Credit" }, "maxItems": 256 },
    "thumbnail": { "$ref": "#/$defs/AssetPath" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
      "maxItems": 16,
      "uniqueItems": true
    },
    "requires": { "$ref": "#/$defs/Requires" },
    "params": { "$ref": "#/$defs/Params" },
    "presets": { "$ref": "#/$defs/Presets" },
    "assets": { "$ref": "#/$defs/Assets" },
    "layers": {
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/TextLayer" },
          { "$ref": "#/$defs/StickerLayer" },
          { "$ref": "#/$defs/ModelLayer" },
          { "$ref": "#/$defs/WarpLayer" },
          { "$ref": "#/$defs/ColorLayer" },
          { "$ref": "#/$defs/ShaderLayer" },
          { "$ref": "#/$defs/CanvasLayer" }
        ],
        "x-discriminator": "type"
      },
      "maxItems": 64,
      "description": "Layers, in order (within each render stage)."
    },
    "events": { "$ref": "#/$defs/EventOptions" },
    "script": { "$ref": "#/$defs/ScriptInfo" }
  },
  "additionalProperties": false,
  "$id": "urn:ouaf:schema:manifest:1",
  "title": "Ouaf v1 filter manifest (Open Universal AR Filter)",
  "$defs": {
    "AnchorName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(:[a-z][A-Za-z0-9]*)?$",
      "x-registry": "anchors",
      "description": "Anchor, e.g. \"forehead\", \"leftEye\", \"noseTip\", \"screen\".",
      "examples": [
        "head", "forehead", "eyes", "leftEye", "rightEye", "noseBridge", "noseTip", "mouth", "upperLip", "lowerLip",
        "chin", "leftCheek", "rightCheek", "leftTemple", "rightTemple", "screen"
      ]
    },
    "Anchored.anchor": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(:[a-z][A-Za-z0-9]*)?$",
      "x-registry": "anchors",
      "description": "Anchor, e.g. \"forehead\", \"leftEye\", \"noseTip\", \"screen\".",
      "default": "head",
      "examples": [
        "head", "forehead", "eyes", "leftEye", "rightEye", "noseBridge", "noseTip", "mouth", "upperLip", "lowerLip",
        "chin", "leftCheek", "rightCheek", "leftTemple", "rightTemple", "screen"
      ]
    },
    "Anchored.excludeFromCapture": {
      "type": "boolean",
      "default": false,
      "description": "Left out of photos/videos and the output stream (overlay only)."
    },
    "Anchored.follow": {
      "anyOf": [
        { "type": "string", "const": "auto" },
        { "type": "string", "const": "rigid" },
        { "type": "string", "const": "expression" }
      ],
      "default": "auto",
      "description": "What the anchor position follows: \"rigid\": the head pose only (stable, ignores expressions); \"expression\": the live landmarks (moves with the mouth, brows…); \"auto\": the anchor default (expression for mouth, upperLip, lowerLip, chin; rigid otherwise). Rotation always follows the head. No effect on \"screen\"."
    },
    "Anchored.offset": {
      "anyOf": [
        {
          "type": "array",
          "additionalItems": false,
          "items": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "minItems": 3,
          "description": "Offset [x, y, z] in the anchor frame (1 unit = distance between the eye centers)."
        },
        { "$ref": "#/$defs/Binding" }
      ],
      "description": "Offset [x, y, z] in the anchor frame (1 unit = distance between the eye centers).",
      "x-bindable": true,
      "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
    },
    "Anchored.orient": {
      "anyOf": [{ "type": "string", "const": "face" }, { "type": "string", "const": "screen" }],
      "default": "face",
      "description": "\"face\": follows the head rotation; \"screen\": stays facing the screen (readable text)."
    },
    "Anchored.overlay": {
      "type": "boolean",
      "default": false,
      "description": "Drawn after color grading, on top of everything (UI, score)."
    },
    "Anchored.rotation": {
      "anyOf": [
        {
          "type": "array",
          "additionalItems": false,
          "items": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "minItems": 3,
          "description": "Rotation [x, y, z] in degrees, in the anchor frame."
        },
        { "$ref": "#/$defs/Binding" }
      ],
      "description": "Rotation [x, y, z] in degrees, in the anchor frame.",
      "x-bindable": true,
      "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
    },
    "Anchored.scale": {
      "anyOf": [
        {
          "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "$ref": "#/$defs/Vec3" }],
          "default": 1,
          "description": "Size multiplier, a number or [x, y, z]."
        },
        { "$ref": "#/$defs/Binding" }
      ],
      "description": "Size multiplier, a number or [x, y, z].",
      "x-bindable": true,
      "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
    },
    "AssetEmoji": {
      "type": "object",
      "required": ["emoji"],
      "properties": { "emoji": { "type": "string", "minLength": 1, "maxLength": 32 } },
      "additionalProperties": false,
      "description": "Emoji drawn as an image, with the platform's emoji font or the host's reference set."
    },
    "AssetEntry": {
      "anyOf": [
        { "$ref": "#/$defs/AssetPath" },
        { "$ref": "#/$defs/AssetFile" },
        { "$ref": "#/$defs/AssetInlineSvg" },
        { "$ref": "#/$defs/AssetEmoji" }
      ],
      "x-hint": "An \"assets/…\" path, { \"src\": \"assets/…\" }, { \"svg\": \"<svg…>\" } or { \"emoji\": \"⭐\" }."
    },
    "AssetFile": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": { "$ref": "#/$defs/AssetPath" },
        "kind": { "$ref": "#/$defs/AssetKind" },
        "alpha": {
          "anyOf": [{ "type": "string", "const": "none" }, { "type": "string", "const": "packed" }],
          "description": "Video: \"packed\" = color on the left half, alpha mask on the right half."
        },
        "frames": {
          "type": "object",
          "required": ["cols", "rows", "fps"],
          "properties": {
            "cols": { "type": "integer", "minimum": 1, "maximum": 64 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 64 },
            "count": { "type": "integer", "minimum": 1 },
            "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }
          },
          "additionalProperties": false,
          "description": "Spritesheet: animated grid of frames."
        }
      },
      "additionalProperties": false
    },
    "AssetInlineSvg": {
      "type": "object",
      "required": ["svg"],
      "properties": {
        "svg": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100000,
          "pattern": "^\\s*(<\\?xml[^>]*>\\s*)?<svg[\\s>]"
        }
      },
      "additionalProperties": false,
      "description": "SVG written inline in the manifest (rendered as an image: no script, no external resource)."
    },
    "AssetKind": {
      "enum": ["image", "spritesheet", "video", "model", "audio", "lut", "shader", "font", "lottie", "data"],
      "description": "Kind of asset (inferred from the file extension when omitted)."
    },
    "AssetParam": {
      "type": "object",
      "required": ["type", "accept"],
      "properties": {
        "type": { "type": "string", "const": "asset" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "accept": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
          "minItems": 1,
          "description": "Accepted MIME types, e.g. [\"image/png\", \"image/svg+xml\"]."
        },
        "maxSize": { "type": "integer", "minimum": 1, "description": "Maximum size in bytes." },
        "optional": { "type": "boolean", "default": false }
      },
      "additionalProperties": false,
      "description": "File supplied by the user or the host (logo, photo…). Treated as an untrusted asset."
    },
    "AssetPath": {
      "type": "string",
      "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
      "maxLength": 256,
      "description": "Relative path inside the package, under \"assets/\", without \"..\".",
      "x-hint": "Put the file in the filter's assets/ folder, e.g. \"assets/hat.glb\"."
    },
    "AssetPick": {
      "type": "object",
      "required": ["pick"],
      "properties": {
        "pick": { "type": "array", "items": { "$ref": "#/$defs/AssetRef" }, "minItems": 1, "maxItems": 64 },
        "by": {
          "anyOf": [{ "type": "string", "const": "face" }, { "type": "string", "const": "random" }],
          "default": "face"
        }
      },
      "additionalProperties": false,
      "description": "Picks one asset from the list: stable per face (\"face\") or on each activation (\"random\")."
    },
    "AssetRef": {
      "type": "string",
      "pattern": "^(builtin:[a-z0-9][a-z0-9/_-]*|assets/(?!.*\\.\\.)[A-Za-z0-9._/-]+|[A-Za-z][A-Za-z0-9_-]{0,63})$",
      "description": "Asset name declared in \"assets\", \"assets/…\" path inside the package, or \"builtin:…\" resource. Remote URLs are forbidden.",
      "x-ref": "asset",
      "x-hint": "Declare the file in \"assets\" and reference it by name, e.g. \"hat\". http(s) URLs are forbidden."
    },
    "Assets": {
      "type": "object",
      "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,63}$": { "$ref": "#/$defs/AssetEntry" } },
      "maxProperties": 256,
      "description": "Asset table: name → file or inline content."
    },
    "Binding": { "anyOf": [{ "$ref": "#/$defs/ParamBinding" }, { "$ref": "#/$defs/DataBinding" }] },
    "BooleanParam": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "boolean" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Checkbox."
    },
    "CanvasLayer": {
      "type": "object",
      "required": ["type", "width", "height"],
      "properties": {
        "type": { "type": "string", "const": "canvas" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "anchor": { "$ref": "#/$defs/Anchored.anchor" },
        "offset": { "$ref": "#/$defs/Anchored.offset" },
        "rotation": { "$ref": "#/$defs/Anchored.rotation" },
        "scale": { "$ref": "#/$defs/Anchored.scale" },
        "orient": { "$ref": "#/$defs/Anchored.orient" },
        "follow": { "$ref": "#/$defs/Anchored.follow" },
        "faces": { "$ref": "#/$defs/FacesSelector" },
        "overlay": { "$ref": "#/$defs/Anchored.overlay" },
        "excludeFromCapture": { "$ref": "#/$defs/Anchored.excludeFromCapture" },
        "width": { "type": "integer", "minimum": 16, "maximum": 2048, "description": "Canvas width in pixels." },
        "height": { "type": "integer", "minimum": 16, "maximum": 2048, "description": "Canvas height in pixels." },
        "size": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "description": "Displayed height in anchor units."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Displayed height in anchor units.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "fps": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "default": 30,
          "description": "Maximum redraws per second; 0 = only on invalidate()."
        }
      },
      "additionalProperties": false,
      "description": "Free-form Canvas 2D drawing by the script (draw.<id> function). Requires an id."
    },
    "Color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "Hex color: #rgb, #rgba, #rrggbb or #rrggbbaa."
    },
    "ColorLayer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "const": "color" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "lut": {
          "type": "string",
          "pattern": "^(builtin:[a-z0-9][a-z0-9/_-]*|assets/(?!.*\\.\\.)[A-Za-z0-9._/-]+|[A-Za-z][A-Za-z0-9_-]{0,63})$",
          "description": ".cube color lookup table (or \"builtin:lut/…\").",
          "x-ref": "asset",
          "x-hint": "Declare the file in \"assets\" and reference it by name, e.g. \"hat\". http(s) URLs are forbidden."
        },
        "intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1,
              "description": "Mix with the original image."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Mix with the original image.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "brightness": {
          "anyOf": [
            { "type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Brightness." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Brightness.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "contrast": {
          "anyOf": [
            { "type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Contrast." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Contrast.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "saturation": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0,
              "description": "Saturation (-1 = black and white)."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Saturation (-1 = black and white).",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0,
              "description": "Temperature (-1 cool, +1 warm)."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Temperature (-1 cool, +1 warm).",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "tint": {
          "anyOf": [{ "$ref": "#/$defs/Color" }, { "$ref": "#/$defs/Binding" }],
          "description": "Hex color: #rgb, #rgba, #rrggbb or #rrggbbaa.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "vignette": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "Vignette." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Vignette.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "grain": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "Film grain." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Film grain.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "region": {
          "anyOf": [{ "type": "string", "const": "all" }, { "type": "string", "const": "face" }],
          "default": "all"
        }
      },
      "additionalProperties": false,
      "description": "Color grading. Several color layers are chained in stack order."
    },
    "ColorParam": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "color" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "$ref": "#/$defs/Color" }
      },
      "additionalProperties": false,
      "description": "Hex color."
    },
    "Credit": {
      "type": "object",
      "required": ["what", "author", "license"],
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Credited item, e.g. \"assets/hat.glb\" or \"Pirata font\"."
        },
        "author": { "type": "string", "minLength": 1, "maxLength": 200 },
        "license": { "$ref": "#/$defs/Spdx" },
        "source": { "type": "string", "maxLength": 500, "description": "Origin (informational only, never loaded)." }
      },
      "additionalProperties": false
    },
    "DataBinding": {
      "type": "object",
      "required": ["bind"],
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Data path, e.g. \"face.blendshapes.jawOpen\", \"face.pose.roll\", \"time\"."
        },
        "map": {
          "type": "object",
          "patternProperties": { "^.*$": {} },
          "description": "Lookup table value → result, e.g. { \"happy\": \"😄\" }."
        },
        "range": {
          "type": "array",
          "additionalItems": false,
          "items": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "description": "Input range [min, max] (clamped)."
        },
        "to": {
          "type": "array",
          "additionalItems": false,
          "items": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "description": "Output range [min, max] (linear interpolation)."
        },
        "default": { "description": "Value used when the data is missing (e.g. no face)." }
      },
      "additionalProperties": false,
      "description": "Tracking data, optionally transformed: { \"bind\": \"face.blendshapes.jawOpen\", \"range\": [0, 1], \"to\": [0.1, 0.6] }."
    },
    "EventOptions": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "threshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "Trigger threshold (0–1)." },
            "minDurationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000,
              "description": "Minimum duration before triggering."
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Tuning of derived events, e.g. { \"mouthOpen\": { \"threshold\": 0.5 } }."
    },
    "FacesSelector": {
      "anyOf": [
        { "type": "string", "const": "all" },
        { "type": "string", "const": "first" },
        { "type": "string", "const": "largest" },
        { "type": "integer", "minimum": 1, "maximum": 16 }
      ],
      "default": "all",
      "description": "Faces affected: \"all\" (one instance per face), \"first\", \"largest\", or a maximum count."
    },
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Lowercase letters, digits and dashes (1 to 64 characters), e.g. \"text-bubble\"."
    },
    "LayerBase.opacity": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1, "description": "Opacity from 0 to 1." },
        { "$ref": "#/$defs/Binding" }
      ],
      "description": "Opacity from 0 to 1.",
      "x-bindable": true,
      "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
    },
    "LayerBase.visible": {
      "anyOf": [{ "type": "boolean", "description": "Visibility." }, { "$ref": "#/$defs/Binding" }],
      "description": "Visibility.",
      "x-bindable": true,
      "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
    },
    "LocalizedText": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "minProperties": 1
        }
      ],
      "description": "Text, or translations: { \"en\": \"Color\", \"fr\": \"Couleur\" }.",
      "x-hint": "Use a string, or an object { \"en\": \"…\", \"fr\": \"…\" }."
    },
    "ModelLayer": {
      "type": "object",
      "required": ["type", "src"],
      "properties": {
        "type": { "type": "string", "const": "model" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "anchor": { "$ref": "#/$defs/Anchored.anchor" },
        "offset": { "$ref": "#/$defs/Anchored.offset" },
        "rotation": { "$ref": "#/$defs/Anchored.rotation" },
        "scale": { "$ref": "#/$defs/Anchored.scale" },
        "orient": { "$ref": "#/$defs/Anchored.orient" },
        "follow": { "$ref": "#/$defs/Anchored.follow" },
        "faces": { "$ref": "#/$defs/FacesSelector" },
        "overlay": { "$ref": "#/$defs/Anchored.overlay" },
        "excludeFromCapture": { "$ref": "#/$defs/Anchored.excludeFromCapture" },
        "src": {
          "anyOf": [{ "$ref": "#/$defs/AssetRef" }, { "$ref": "#/$defs/AssetPick" }, { "$ref": "#/$defs/Shape" }],
          "description": "glTF/GLB model, random pick, or procedural primitive."
        },
        "fit": {
          "type": "object",
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false,
          "description": "Rescales the model so its bounding box has this width/height (anchor units)."
        },
        "animation": { "type": "string", "description": "glTF animation started on activation." },
        "loop": { "type": "boolean", "default": true },
        "occlusion": {
          "anyOf": [{ "type": "string", "const": "none" }, { "type": "string", "const": "head" }],
          "default": "none",
          "description": "\"head\": the part of the model hidden by the head is masked (hat, glasses temples)."
        }
      },
      "additionalProperties": false,
      "description": "3D object attached to an anchor."
    },
    "Name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "description": "Starts with a letter; letters, digits, \"_\" and \"-\" (64 characters max)."
    },
    "NumberParam": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "number" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false,
      "description": "Number, e.g. { \"type\": \"number\", \"default\": 1, \"min\": 0.5, \"max\": 2, \"step\": 0.1 }."
    },
    "ParamBinding": {
      "type": "object",
      "required": ["param"],
      "properties": { "param": { "$ref": "#/$defs/Name" } },
      "additionalProperties": false,
      "description": "Value of the named parameter, e.g. { \"param\": \"color\" }."
    },
    "ParamCommon.apply": {
      "anyOf": [{ "type": "string", "const": "live" }, { "type": "string", "const": "reload" }],
      "default": "live",
      "description": "\"live\": applied on the next frame; \"reload\": preloaded then swapped (e.g. a different model)."
    },
    "ParamCommon.transition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Default transition duration in ms (numbers, colors, vectors)."
    },
    "ParamCommon.visibleIf": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
          "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
        }
      },
      "description": "Shows this parameter only when other parameters have these values, e.g. { \"confetti\": true }."
    },
    "ParamDef": {
      "anyOf": [
        { "$ref": "#/$defs/NumberParam" },
        { "$ref": "#/$defs/BooleanParam" },
        { "$ref": "#/$defs/StringParam" },
        { "$ref": "#/$defs/TextParam" },
        { "$ref": "#/$defs/ColorParam" },
        { "$ref": "#/$defs/SelectParam" },
        { "$ref": "#/$defs/Vec2Param" },
        { "$ref": "#/$defs/Vec3Param" },
        { "$ref": "#/$defs/AssetParam" }
      ],
      "x-discriminator": "type",
      "description": "Parameter definition; the \"type\" field determines the other fields."
    },
    "Params": {
      "type": "object",
      "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,63}$": { "$ref": "#/$defs/ParamDef" } },
      "maxProperties": 64,
      "description": "Tunable filter parameters."
    },
    "Presets": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
          "type": "object",
          "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {} },
          "description": "Parameter values."
        }
      },
      "description": "Named presets, e.g. { \"party\": { \"size\": 1.5 } }."
    },
    "Requires": {
      "type": "object",
      "properties": {
        "face": { "type": "boolean", "description": "Face tracking (478 landmarks, pose, and blendshapes when used)." },
        "blendshapes": {
          "type": "boolean",
          "description": "The filter does not work without blendshapes: the engine never drops them and hides the filter rather than degrading it (spec 16.2). Requires \"face\"."
        },
        "hands": { "type": "boolean", "description": "Hand tracking (reserved, phase 2)." },
        "segmentation": { "type": "boolean", "description": "Person / background mask (reserved, phase 2)." },
        "pose": { "type": "boolean", "description": "Body pose (reserved, pose plugin)." },
        "audio": { "type": "boolean", "description": "Microphone and audio analysis (reserved, phase 3)." },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(@[\\^~]?\\d+(\\.\\d+){0,2})?$",
            "description": "Required plugin, e.g. \"mood@^1\"."
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Required capabilities: the engine only loads these trackers."
    },
    "ScriptInfo": {
      "type": "object",
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "const": "script.js" },
        "setup": { "type": "boolean", "description": "The script defines setup(f)." },
        "update": { "type": "boolean", "description": "The script defines update(f, frame)." },
        "on": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Events listened to."
        },
        "draw": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true,
          "description": "Canvas layers drawn by the script."
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "x-registry": "scriptData",
            "examples": ["face.pose", "face.blendshapes", "face.anchors", "face.landmarks", "pairs"]
          },
          "uniqueItems": true,
          "description": "Data sent to the script (minimization). Default: face.pose and face.blendshapes."
        }
      },
      "additionalProperties": false,
      "description": "Filled in by ouaf pack: what script.js contains."
    },
    "SelectParam": {
      "type": "object",
      "required": ["type", "default", "options"],
      "properties": {
        "type": { "type": "string", "const": "select" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "type": "string" },
        "options": {
          "anyOf": [
            {
              "type": "object",
              "patternProperties": { "^.*$": { "$ref": "#/$defs/LocalizedText" } },
              "minProperties": 1,
              "description": "Value → label."
            },
            {
              "type": "object",
              "required": ["from"],
              "properties": { "from": { "type": "string", "const": "host" } },
              "additionalProperties": false,
              "description": "Options supplied at runtime by the host page."
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Choice list, e.g. { \"type\": \"select\", \"default\": \"gold\", \"options\": { \"gold\": \"Gold crown\", \"flowers\": \"Flowers\" } }."
    },
    "SemVer": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version, e.g. \"1.0.0\"."
    },
    "ShaderLayer": {
      "type": "object",
      "required": ["type", "src"],
      "properties": {
        "type": { "type": "string", "const": "shader" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "src": {
          "type": "string",
          "pattern": "^(builtin:[a-z0-9][a-z0-9/_-]*|assets/(?!.*\\.\\.)[A-Za-z0-9._/-]+|[A-Za-z][A-Za-z0-9_-]{0,63})$",
          "description": "GLSL ES 3.0 .frag file defining vec4 effect(vec2 uv).",
          "x-ref": "asset",
          "x-hint": "Declare the file in \"assets\" and reference it by name, e.g. \"hat\". http(s) URLs are forbidden."
        },
        "stage": {
          "anyOf": [
            { "type": "string", "const": "background" },
            { "type": "string", "const": "face" },
            { "type": "string", "const": "post" }
          ],
          "default": "post",
          "description": "Where the effect applies: background, face only, or full screen."
        },
        "uniforms": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "anyOf": [
                {
                  "anyOf": [
                    { "type": "number" },
                    { "type": "boolean" },
                    { "$ref": "#/$defs/Vec2" },
                    { "$ref": "#/$defs/Vec3" },
                    { "$ref": "#/$defs/Color" }
                  ]
                },
                { "$ref": "#/$defs/Binding" }
              ],
              "x-bindable": true,
              "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
            }
          },
          "maxProperties": 32,
          "description": "Declared uniforms, available by name in the shader."
        },
        "textures": {
          "type": "object",
          "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,63}$": { "$ref": "#/$defs/AssetRef" } },
          "maxProperties": 4,
          "description": "Extra textures (sampler2D of the same name)."
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnchorName" },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Face anchors given to the shader as ouaf_anchor_<name>[OUAF_MAX_FACES]."
        }
      },
      "additionalProperties": false,
      "description": "Custom effect written in GLSL (fragment only)."
    },
    "Shape": {
      "type": "object",
      "required": ["shape"],
      "properties": {
        "shape": {
          "enum": ["box", "sphere", "torus", "ring", "cone", "cylinder", "plane"],
          "description": "Procedural 3D primitive (size 1 unit, adjusted with scale)."
        },
        "color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Hex color: #rgb, #rgba, #rrggbb or #rrggbbaa.",
          "default": "#ffffff"
        },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "emissive": { "$ref": "#/$defs/Color" },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.2,
          "description": "Torus and ring: width of the band (outer minus inner radius), the outer diameter being 1."
        }
      },
      "additionalProperties": false,
      "description": "Shape generated without a file, e.g. { \"shape\": \"torus\", \"color\": \"#ff00cc\" }."
    },
    "Spdx": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
      "description": "SPDX license identifier, e.g. \"CC0-1.0\", \"MIT\", \"CC-BY-4.0\"."
    },
    "StickerLayer": {
      "type": "object",
      "required": ["type", "src"],
      "properties": {
        "type": { "type": "string", "const": "sticker" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "anchor": { "$ref": "#/$defs/Anchored.anchor" },
        "offset": { "$ref": "#/$defs/Anchored.offset" },
        "rotation": { "$ref": "#/$defs/Anchored.rotation" },
        "scale": { "$ref": "#/$defs/Anchored.scale" },
        "orient": { "$ref": "#/$defs/Anchored.orient" },
        "follow": { "$ref": "#/$defs/Anchored.follow" },
        "faces": { "$ref": "#/$defs/FacesSelector" },
        "overlay": { "$ref": "#/$defs/Anchored.overlay" },
        "excludeFromCapture": { "$ref": "#/$defs/Anchored.excludeFromCapture" },
        "src": {
          "anyOf": [{ "$ref": "#/$defs/AssetRef" }, { "$ref": "#/$defs/AssetPick" }],
          "description": "Image, spritesheet or video."
        },
        "size": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "description": "Height in anchor units (width follows the aspect ratio)."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Height in anchor units (width follows the aspect ratio).",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "blend": { "enum": ["normal", "add", "multiply", "screen"], "default": "normal" },
        "loop": { "type": "boolean", "default": true, "description": "Video / spritesheet: loop playback." },
        "autoplay": { "type": "boolean", "default": true },
        "rate": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 4, "default": 1, "description": "Playback rate." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Playback rate.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        }
      },
      "additionalProperties": false,
      "description": "2D image or animation attached to an anchor."
    },
    "StringParam": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "string" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "type": "string" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "additionalProperties": false,
      "description": "Short single-line text."
    },
    "TextLayer": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "type": "string", "const": "text" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "anchor": { "$ref": "#/$defs/Anchored.anchor" },
        "offset": { "$ref": "#/$defs/Anchored.offset" },
        "rotation": { "$ref": "#/$defs/Anchored.rotation" },
        "scale": { "$ref": "#/$defs/Anchored.scale" },
        "orient": { "$ref": "#/$defs/Anchored.orient" },
        "follow": { "$ref": "#/$defs/Anchored.follow" },
        "faces": { "$ref": "#/$defs/FacesSelector" },
        "overlay": { "$ref": "#/$defs/Anchored.overlay" },
        "excludeFromCapture": { "$ref": "#/$defs/Anchored.excludeFromCapture" },
        "text": {
          "anyOf": [
            { "type": "string", "maxLength": 500, "description": "Displayed text (emoji included)." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Displayed text (emoji included).",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "size": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0, "default": 0.3, "description": "Line height, in anchor units." },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Line height, in anchor units.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "font": {
          "type": "string",
          "pattern": "^(builtin:[a-z0-9][a-z0-9/_-]*|assets/(?!.*\\.\\.)[A-Za-z0-9._/-]+|[A-Za-z][A-Za-z0-9_-]{0,63})$",
          "description": "Font: WOFF2 asset or \"builtin:font/…\".",
          "x-ref": "asset",
          "x-hint": "Declare the file in \"assets\" and reference it by name, e.g. \"hat\". http(s) URLs are forbidden.",
          "default": "builtin:font/sans-bold"
        },
        "color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rgba, #rrggbb or #rrggbbaa.",
              "default": "#ffffff"
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Hex color: #rgb, #rgba, #rrggbb or #rrggbbaa.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "outline": {
          "type": "object",
          "required": ["width", "color"],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "description": "Thickness relative to the text size."
            },
            "color": { "$ref": "#/$defs/Color" }
          },
          "additionalProperties": false
        },
        "shadow": {
          "type": "object",
          "required": ["color"],
          "properties": {
            "color": { "$ref": "#/$defs/Color" },
            "blur": { "type": "number", "minimum": 0, "maximum": 1 },
            "offset": { "$ref": "#/$defs/Vec2" }
          },
          "additionalProperties": false
        },
        "align": {
          "anyOf": [
            { "type": "string", "const": "left" },
            { "type": "string", "const": "center" },
            { "type": "string", "const": "right" }
          ],
          "default": "center"
        },
        "maxWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum width before wrapping (anchor units)."
        },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 3, "default": 1.2 }
      },
      "additionalProperties": false,
      "description": "Text attached to an anchor. Rasterized once into a texture, redrawn only when it changes."
    },
    "TextParam": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "text" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "type": "string" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "additionalProperties": false,
      "description": "Long multi-line text."
    },
    "Vec2": {
      "type": "array",
      "additionalItems": false,
      "items": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "description": "[x, y]"
    },
    "Vec2Param": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "vec2" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "$ref": "#/$defs/Vec2" }
      },
      "additionalProperties": false,
      "description": "2D vector."
    },
    "Vec3": {
      "type": "array",
      "additionalItems": false,
      "items": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "description": "[x, y, z]"
    },
    "Vec3Param": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "const": "vec3" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "group": { "$ref": "#/$defs/LocalizedText" },
        "visibleIf": { "$ref": "#/$defs/ParamCommon.visibleIf" },
        "apply": { "$ref": "#/$defs/ParamCommon.apply" },
        "transition": { "$ref": "#/$defs/ParamCommon.transition" },
        "default": { "$ref": "#/$defs/Vec3" }
      },
      "additionalProperties": false,
      "description": "3D vector (e.g. an offset)."
    },
    "WarpLayer": {
      "type": "object",
      "required": ["type", "kind", "anchor"],
      "properties": {
        "type": { "type": "string", "const": "warp" },
        "id": { "$ref": "#/$defs/Id" },
        "visible": { "$ref": "#/$defs/LayerBase.visible" },
        "opacity": { "$ref": "#/$defs/LayerBase.opacity" },
        "kind": { "enum": ["bulge", "pinch", "swirl", "stretch"], "description": "Kind of deformation." },
        "anchor": {
          "anyOf": [
            { "$ref": "#/$defs/AnchorName" },
            { "type": "array", "items": { "$ref": "#/$defs/AnchorName" }, "minItems": 1, "maxItems": 8 }
          ],
          "description": "Center(s) of the deformation."
        },
        "radius": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5,
              "default": 0.5,
              "description": "Radius in face units."
            },
            { "$ref": "#/$defs/Binding" }
          ],
          "description": "Radius in face units.",
          "x-bindable": true,
          "x-hint": "Fixed value, { \"param\": \"name\" } or { \"bind\": \"face.…\" }."
        },
        "strength": {
          "anyOf": [
            { "type": "number", "minimum": -1, "maximum": 1, "default": 0.3, "description": "Strength from -1 to 1." },
